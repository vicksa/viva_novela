# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# Postgres (Supabase). Use a connection string do "Session pooler" (Connect >
# Session pooler), não o "Direct connection" — o host direto (db.xxx.supabase.co)
# só resolve por IPv6 em projetos novos e costuma falhar (ENOTFOUND) em redes
# que só têm IPv4.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:senha@aws-0-regiao.pooler.supabase.com:5432/postgres

# Supabase (Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# Opcional: não é mais usada para validar token localmente (o projeto usa
# chaves assimétricas ES256/JWKS) — auth.middleware.js valida via
# supabaseAuth.auth.getUser() em vez disso.
SUPABASE_JWT_SECRET=seu-jwt-secret

# Mercado Pago (developers.mercadopago.com > Suas integrações > Credenciais / Webhooks)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=seu-webhook-secret

# Firebase (Entrega 3)
# FIREBASE_PROJECT_ID=viva-novela
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@viva-novela.iam.gserviceaccount.com
